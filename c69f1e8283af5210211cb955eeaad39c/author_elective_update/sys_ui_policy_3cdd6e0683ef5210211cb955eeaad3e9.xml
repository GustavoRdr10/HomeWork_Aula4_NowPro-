        <script_false><![CDATA[function onCondition() {
	g_form.hideAllFieldMsgs('data_e_hora_da_solicitacao');
}]]></script_false>
        <script_true><![CDATA[function onCondition() {
    var currentDate = new Date(); // Obtém a data e hora atuais
    var requestDate = g_form.getValue('data_e_hora_da_solicitacao'); // Obtém o valor do campo

    if (requestDate) {
        var selectDate = new Date(requestDate); // Converte o valor do campo para um objeto Date

        // Se a data selecionada for menor que a data atual
        if (selectDate < currentDate) {
            alert("A data da solicitação não pode ser menor que a atual.");
            g_form.showFieldMsg('data_e_hora_da_solicitacao', 'A data da solicitação não pode ser menor que a atual.', 'error');

            // Ajusta a data para a atual (formatando corretamente para ServiceNow)
            var nowFormatted = currentDate.toISOString().slice(0, 19).replace("T", " "); // Converte para formato "YYYY-MM-DD HH:MM:SS"
            g_form.setValue('data_e_hora_da_solicitacao', nowFormatted);
        }
    }
}
]]></script_true>
