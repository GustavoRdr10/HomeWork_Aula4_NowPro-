        <name>Data de Solicitação não seja inferior à </name>
        <order/>
        <script><![CDATA[function onLoad() {
    var dataSolicitacao = g_form.getValue('data_e_hora_da_solicitacao');
    var dataAtual = new GlideDateTime();
    
    if (dataSolicitacao && new GlideDateTime(dataSolicitacao).compareTo(dataAtual) < 0) {
        g_form.setValue('data_e_hora_da_solicitacao', dataAtual.getDisplayValue());
        g_form.showFieldMsg('data_e_hora_da_solicitacao', 'A data de solicitação não pode ser inferior à atual', 'error');
    }
}
]]></script>
